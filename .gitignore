# Scraped output: the directory tree may be committed, its contents never are.
# Reviews and blurbs are copyrighted third-party text and covers are licensed
# artwork -- none of it belongs in version control.
# NB: this must be "data/*", not "data/" -- git will not descend into an excluded
# directory, so a bare "data/" would make the .gitkeep negation below dead.
data/*
!data/.gitkeep

# Cross-process append guards (see Storage.file_lock). Empty sidecar files that
# only exist so two concurrent runs cannot truncate each other's writes.
*.lock

# Any alternate output roots used while testing filename styles or batch runs.
# The batch manifest lives at the output root, so it is excluded with the rest of
# the tree: it is a record of one run, regenerated by the next.
data-spaced/
data-*/
out/

# Virtualenv
.venv/
venv/

# Python
__pycache__/
*.pyc
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Throwaway recon/probe scratch: saved page dumps, offline harnesses, per-agent
# output directories. Nothing the shipped program depends on.
.recon/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
